          Show Trail: false
          Value: true
        gripper_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        jaw_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        lower_arm_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        shoulder_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        upper_arm_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        world:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        wrist_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: SO-101
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 5
      Frames:
        All Enabled: true
        aruco_marker_0:
          Value: true
        aruco_marker_1:
          Value: true
        aruco_marker_17:
          Value: true
        aruco_object_origin:
          Value: true
        base_link:
          Value: true
        base_link_predict:
          Value: true
        camera_link:
          Value: true
        camera_optical_frame:
          Value: true
        gripper_link:
          Value: true
        jaw_link:
          Value: true
        lower_arm_link:
          Value: true
        shoulder_link:
          Value: true
        tcp_link:
          Value: true
        upper_arm_link:
          Value: true
        world:
          Value: true
        wrist_link:
          Value: true
      Marker Scale: 0.20000000298023224
      Name: TF origins
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        world:
          base_link:
            camera_link:
              camera_optical_frame:
                aruco_marker_0:
                  base_link_predict:
                    {}
                aruco_marker_1:
                  aruco_object_origin:
                    {}
                aruco_marker_17:
                  {}
            shoulder_link:
              upper_arm_link:
                lower_arm_link:
                  wrist_link:
                    gripper_link:
                      jaw_link:
                        {}
                      tcp_link:
                        {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Object 20mm
      Namespaces:
        aruco_object: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aruco/object_marker
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aruco/image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
