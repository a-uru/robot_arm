<?xml version="1.0"?>
<package format="3">
  <name>so101_servo</name><version>0.1.0</version>
  <description>Position-only target tracking for SO-101 with MoveIt Servo.</description>
  <maintainer email="akira@example.com">akira</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>interactive_markers</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
