<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="so101_follower_ros2_control" params="name use_fake_hardware initial_positions_file">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
          <param name="joint_commands_topic">/so101_follower/joint_commands</param>
          <param name="joint_states_topic">/so101_follower/joint_states</param>
        </xacro:unless>
      </hardware>
      <xacro:macro name="controlled_joint" params="joint_name">
        <joint name="${joint_name}">
          <command_interface name="position"/>
          <state_interface name="position">
            <param name="initial_value">${initial_positions[joint_name]}</param>
          </state_interface>
        </joint>
      </xacro:macro>
      <xacro:controlled_joint joint_name="shoulder_pan"/>
      <xacro:controlled_joint joint_name="shoulder_lift"/>
      <xacro:controlled_joint joint_name="elbow_flex"/>
      <xacro:controlled_joint joint_name="wrist_flex"/>
      <xacro:controlled_joint joint_name="wrist_roll"/>
      <xacro:controlled_joint joint_name="gripper"/>
    </ros2_control>
  </xacro:macro>
</robot>
